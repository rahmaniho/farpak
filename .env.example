# Production site URL (canonical, hreflang, sitemap)
PUBLIC_SITE_URL=https://example.com
# Form endpoint. Default: /api/submit (same origin). Only change for a separate domain.
PUBLIC_FORM_ENDPOINT=

# ---- form-server (server-side only, never prefixed with PUBLIC_) ----
# Comma-separated allowed origins. REQUIRED in production.
ALLOWED_ORIGINS=https://example.com
# Optional relay (CRM / Slack / email automation). If empty, submissions go to form-server/inbox/.
FORM_WEBHOOK_URL=
FORM_PORT=8787
RATE_LIMIT=5
