---
import { t, localePath, type Locale } from '../i18n/utils';
import type { Project } from '../content/projects';
import { sampleBadge } from '../content/sample';
import PageHero from './PageHero.astro';

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const tr = t(locale);
const c = project.copy[locale];
const fmt = new Intl.NumberFormat(locale === 'fa' ? 'fa-IR' : 'en-US');
const idx = 'PRJ-' + String(project.year).slice(2);
const rows = [
  { label: 'projectClient', value: c.client },
  { label: 'projectScope', value: c.scope },
  { label: 'projectYear', value: fmt.format(project.year) },
] as const;
const panels = [
  { h: 'projectChallenge', acc: 'var(--color-siren)' },
  { h: 'projectSolution', acc: 'var(--color-flux)' },
  { h: 'projectResults', acc: 'var(--color-volt)' },
] as const;
---
<PageHero locale={locale} index={idx.slice(-2)} kicker={tr('projectsKicker')} title={c.title} lead={c.summary} image={project.image} imageAlt={project.imageAlt[locale]}>
  <p class="mt-7 flex flex-wrap items-center gap-3 enter" style="--d: 320ms">
    <a href={localePath(locale, '/projects/')} class="link-arrow">
      {tr('backToProjects')}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
    </a>
    {project.sample && <span class="badge-sample">{sampleBadge(locale)}</span>}
  </p>
</PageHero>

<section class="section" aria-labelledby={`prj-${project.slug}-h`}>
  <div class="shell-wide">
    <h2 id={`prj-${project.slug}-h`} class="sr-only">{c.title}</h2>
    <p class="mono-label mb-8" data-reveal>{tr('specSheetLabel')} · {idx}</p>

    <dl class="spec max-w-3xl" data-reveal>
      {rows.map((r) => (
        <div class="spec-row">
          <dt>{tr(r.label)}</dt>
          <dd>{r.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-14 grid gap-5 md:grid-cols-3" data-stagger>
      {panels.map((p, i) => (
        <section aria-labelledby={`${project.slug}-${p.h}`} class="slab ticks panel" style={`--acc: ${p.acc}`} data-reveal>
          <p class="mono mb-3 text-[0.625rem] uppercase tracking-[0.24em]" style={`color: ${p.acc}`} aria-hidden="true">
            {['A', 'B', 'C'][i]}
          </p>
          <h3 id={`${project.slug}-${p.h}`} class="text-[1.1rem] font-bold">{tr(p.h)}</h3>
          {p.h === 'projectResults' ? (
            <ul class="mt-4 space-y-3">
              {c.results.map((r) => (
                <li class="flex gap-3 text-sm leading-relaxed text-fog">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full" style={`background: ${p.acc}`} aria-hidden="true"></span>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm leading-relaxed text-fog">{p.h === 'projectChallenge' ? c.challenge : c.solution}</p>
          )}
        </section>
      ))}
    </div>
  </div>
</section>
