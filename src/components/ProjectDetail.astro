---
import { t, localePath, type Locale } from '../i18n/utils';
import type { Project } from '../content/projects';
import { sampleBadge } from '../content/sample';
import Picture from './Picture.astro';

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const tr = t(locale);
const c = project.copy[locale];
const rows = [
  { label: 'projectClient', value: c.client },
  { label: 'projectScope', value: c.scope },
  { label: 'projectYear', value: String(project.year) },
] as const;
---
<article class="mx-auto max-w-[1280px] px-4 py-12 md:px-8">
  <nav aria-label={locale === 'fa' ? 'مسیر صفحه' : 'Breadcrumb'}>
    <a href={localePath(locale, '/projects/')} class="text-sm font-medium text-teal hover:underline">← {tr('backToProjects')}</a>
  </nav>

  <div class="mt-6 grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      {project.sample && <span class="inline-block rounded bg-alert px-2 py-1 text-xs font-semibold text-white">{sampleBadge(locale)}</span>}
      <h1 class="mt-3">{c.title}</h1>
      <p class="mt-4 text-lg text-slate-700">{c.summary}</p>
      <dl class="mt-6 space-y-3 text-sm">
        {rows.map((r) => (
          <div class="flex gap-2">
            <dt class="font-semibold text-navy">{tr(r.label)}:</dt>
            <dd class="text-ink">{r.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <Picture src={project.image} alt={project.imageAlt[locale]} width={800} height={600} loading="eager" fetchpriority="high"
      sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-xl object-cover" />
  </div>

  <div class="mt-16 grid gap-10 md:grid-cols-3">
    <section class="rounded-xl bg-mist p-6" aria-labelledby="ch-h">
      <h2 id="ch-h" class="text-xl">{tr('projectChallenge')}</h2>
      <p class="mt-3 text-slate-700">{c.challenge}</p>
    </section>
    <section class="rounded-xl bg-mist p-6" aria-labelledby="sol-h">
      <h2 id="sol-h" class="text-xl">{tr('projectSolution')}</h2>
      <p class="mt-3 text-slate-700">{c.solution}</p>
    </section>
    <section class="rounded-xl bg-mist p-6" aria-labelledby="res-h">
      <h2 id="res-h" class="text-xl">{tr('projectResults')}</h2>
      <ul class="mt-3 list-disc space-y-2 ps-5 text-slate-700">
        {c.results.map((r) => <li>{r}</li>)}
      </ul>
    </section>
  </div>
</article>
