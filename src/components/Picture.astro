---
/**
 * Responsive <picture> with AVIF → WebP → JPG fallbacks.
 * Expects variants generated by `npm run images` (see scripts/optimize-images.mjs).
 */
interface Props {
  /** Path to the original JPG, e.g. /images/hero.jpg */
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { src, alt, width, height, sizes = '100vw', loading = 'lazy', fetchpriority = 'auto', class: className } = Astro.props;
const base = src.replace(/\.jpe?g$/i, '');
const srcset = (ext: string) => `${base}-800.${ext} 800w, ${base}-1600.${ext} 1600w`;
---
<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img src={src} alt={alt} width={width} height={height} sizes={sizes} loading={loading}
    fetchpriority={fetchpriority} decoding="async" class={className} />
</picture>
