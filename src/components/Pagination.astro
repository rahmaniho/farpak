---
import { t, type Locale } from '../i18n/utils';
import { listingUrl, type ListingState } from '../lib/newsListing';

interface Props {
  locale: Locale;
  state: ListingState;
  totalPages: number;
}
const { locale, state, totalPages } = Astro.props;
const tr = t(locale);
const current = state.page;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const url = (page: number) => listingUrl(locale, { topic: state.topic, page });
const itemClass =
  'grid min-w-11 place-items-center rounded-[4px] border border-line-2 bg-[rgba(13,20,38,0.5)] px-3.5 py-2.5 text-center font-mono text-sm font-medium text-fog transition-all duration-200 hover:-translate-y-0.5 hover:border-[rgba(0,229,255,0.5)] hover:text-flux';
---
{totalPages > 1 && (
  <nav aria-label={tr('paginationLabel')} class="mt-14 flex flex-wrap items-center justify-center gap-2">
    {current > 1 && (
      <a href={url(current - 1)} rel="prev" class={itemClass}>{tr('pagePrev')}</a>
    )}
    <ul class="flex flex-wrap items-center gap-2">
      {pages.map((p) => (
        <li>
          {p === current ? (
            <span aria-current="page" class="grid min-w-11 place-items-center rounded-[4px] bg-flux px-3.5 py-2.5 text-center font-mono text-sm font-bold text-void shadow-[0_0_24px_-6px_rgba(0,229,255,0.9)]">
              {p}
            </span>
          ) : (
            <a href={url(p)} class={itemClass} aria-label={`${tr('pageLabel')} ${p}`}>{p}</a>
          )}
        </li>
      ))}
    </ul>
    {current < totalPages && (
      <a href={url(current + 1)} rel="next" class={itemClass}>{tr('pageNext')}</a>
    )}
  </nav>
)}
