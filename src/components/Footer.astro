---
import { t, type Locale, localePath } from '../i18n/utils';
import { sampleContact } from '../content/sample';
import { withBase } from '../lib/base';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-navy text-white">
  <div class="mx-auto grid max-w-[1280px] gap-10 px-4 py-14 md:grid-cols-3 md:px-8">
    <div>
      <div class="flex items-center gap-3">
        <img src={withBase("/images/brand/logo-256.webp")} alt="" width="56" height="56" class="size-14 shrink-0 rounded-md bg-white p-1" decoding="async" />
        <p class="text-lg font-semibold">{tr('siteName')}</p>
      </div>
      <p class="mt-2 text-sm text-slate-300">{tr('footerTagline')}</p>
    </div>
    <div>
      <h2 class="mb-3 text-base font-semibold">{tr('footerContact')}</h2>
      <ul class="space-y-2 text-sm text-slate-200">
        <li>{sampleContact.address[locale]}</li>
        <li dir="ltr">{sampleContact.phone}</li>
        <li dir="ltr">{sampleContact.email}</li>
      </ul>
    </div>
    <div>
      <h2 class="mb-3 text-base font-semibold">{tr('footerLinks')}</h2>
      <ul class="space-y-2 text-sm">
        <li><a class="underline-offset-4 hover:underline" href={localePath(locale, '/services/')}>{tr('navServices')}</a></li>
        <li><a class="underline-offset-4 hover:underline" href={localePath(locale, '/about/')}>{tr('navAbout')}</a></li>
        <li><a class="underline-offset-4 hover:underline" href={localePath(locale, '/contact/')}>{tr('navContact')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="mx-auto max-w-[1280px] px-4 py-6 text-xs text-slate-300 md:px-8">
      © {year} {tr('siteName')}. {tr('footerRights')} {tr('footerLegal')}
    </p>
  </div>
</footer>
