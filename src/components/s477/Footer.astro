---
import { withBase } from '../../lib/base';
import { BIZ, s477Services } from '../../content/s477';

const year = new Date().getFullYear();
---
<footer class="relative mt-24 border-t border-line bg-white/80 backdrop-blur-md">
  <div class="hatch-accent h-1.5 w-full" style="--acc: var(--color-volt)" aria-hidden="true"></div>
  <div class="shell-wide pb-10 pt-14">
    <div class="footer-grid">
      <div>
        <p class="text-lg font-extrabold">{BIZ.nameFull}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-fog">{BIZ.slogan}</p>
        <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-fog">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-[#047857]" aria-hidden="true">
            <path d="M12 3 5 6v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6l-7-3Z" /><path d="m9 12 2.2 2.2L15.5 10" />
          </svg>
          <span>{BIZ.trustPath}</span>
        </p>
      </div>

      <nav aria-label="خدمات">
        <h2 class="footer-h">خدمات</h2>
        <ul class="space-y-0.5 text-sm">
          {s477Services.map((s) => (
            <li><a class="footer-link" href={withBase(`/477/services/${s.slug}/`)}>{s.title}</a></li>
          ))}
          <li><a class="footer-link" href={withBase("/477/services/")}>همه خدمات</a></li>
        </ul>
      </nav>

      <div class="nap">
        <h2 class="footer-h">تماس و مسیریابی</h2>
        <ul class="space-y-2.5 text-sm text-fog">
          <li>
            <address class="leading-relaxed text-chalk/90">{BIZ.address}</address>
          </li>
          {BIZ.phones.map((p) => (
            <li>
              <a class="link-arrow" style="--acc: var(--color-flux)" href={`tel:${p.tel}`} dir="ltr">{p.display}</a>
            </li>
          ))}
          <li>
            <a class="link-arrow" style="--acc: var(--color-ember)" href={BIZ.instagram} target="_blank" rel="noopener noreferrer" dir="ltr">
              {BIZ.instagramHandle}
            </a>
          </li>
          <li>
            <a class="link-arrow" style="--acc: var(--color-volt)" href={BIZ.maps} target="_blank" rel="noopener noreferrer">مسیریابی به دفتر</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="footer-h">درباره این وب‌سایت</h2>
        <p class="text-xs leading-relaxed text-fog">
          این وب‌سایت برای معرفی خدمات و ایجاد راه ارتباطی با دفتر است و فروش اینترنتی یا پرداخت آنلاین ندارد.
          درخواست‌های ثبت‌شده از طریق فرم‌ها، فقط برای پیگیری اداری نگهداری می‌شوند.
        </p>
        <p class="mono mt-4 text-[0.625rem] uppercase tracking-[0.18em] text-ash" dir="ltr">
          QZV-477 / REV.01 / {year}
        </p>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-6 text-xs text-fog">
      <p>© {year} {BIZ.nameFull}. تمامی حقوق محفوظ است.</p>
    </div>
  </div>
</footer>
