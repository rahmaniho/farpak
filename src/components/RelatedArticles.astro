---
import { t, localePath, type Locale } from '../i18n/utils';
import { topicLabels, type Article } from '../content/news';
import { relatedArticles } from '../lib/newsListing';
import { sampleBadge } from '../content/sample';
import Picture from './Picture.astro';
import SectionHead from './SectionHead.astro';

interface Props { locale: Locale; article: Article; count?: number }
const { locale, article, count = 3 } = Astro.props;
const tr = t(locale);
const items = relatedArticles(article, count);
const fmt = new Intl.DateTimeFormat(locale === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { dateStyle: 'medium' });
const accents = ['var(--color-flux)', 'var(--color-volt)', 'var(--color-ember)'];
---
{items.length > 0 && (
  <section aria-labelledby="related-h" class="section border-t border-line bg-[rgba(9,14,28,0.6)]">
    <div class="shell-wide">
      <SectionHead locale={locale} index="+" kicker={tr('newsKicker')} title={tr('relatedTitle')} id="related-h" acc="var(--color-volt)" />
      <ul class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-stagger>
        {items.map((r, i) => (
          <li data-reveal>
            <a href={localePath(locale, `/news/${r.slug}/`)} class="card ticks group h-full" style={`--acc: ${accents[i % accents.length]}`} data-spot>
              <div class="duotone aspect-[16/9]">
                <Picture src={r.image} alt={r.imageAlt[locale]} width={800} height={600} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" class="size-full" />
                {r.sample && <span class="badge-sample absolute start-3 top-3 z-10">{sampleBadge(locale)}</span>}
              </div>
              <div class="card-body">
                <div class="flex items-center justify-between gap-2">
                  <span class="chip chip-accent" style={`--acc: ${accents[i % accents.length]}`}>{topicLabels[r.topic][locale]}</span>
                  <time class="mono text-[0.625rem] uppercase tracking-[0.14em] text-ash" datetime={r.date}>{fmt.format(new Date(r.date))}</time>
                </div>
                <h3 class="text-[1.05rem] font-bold leading-snug transition-colors duration-300 group-hover:text-volt">{r.copy[locale].title}</h3>
                <p class="flex-1 text-sm leading-relaxed text-fog">{r.copy[locale].summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
