---
import { t, localePath, type Locale } from '../i18n/utils';
import { topicLabels, type Article } from '../content/news';
import { relatedArticles } from '../lib/newsListing';
import { sampleBadge } from '../content/sample';
import Picture from './Picture.astro';

interface Props { locale: Locale; article: Article; count?: number }
const { locale, article, count = 3 } = Astro.props;
const tr = t(locale);
const items = relatedArticles(article, count);
const fmt = new Intl.DateTimeFormat(locale === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { dateStyle: 'medium' });
---
{items.length > 0 && (
  <section aria-labelledby="related-h" class="mx-auto max-w-[1280px] border-t border-slate-200 px-4 py-16 md:px-8">
    <h2 id="related-h">{tr('relatedTitle')}</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((r) => (
        <li class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <a href={localePath(locale, `/news/${r.slug}/`)} class="group flex flex-1 flex-col">
            <div class="relative">
              <Picture src={r.image} alt={r.imageAlt[locale]} width={800} height={600} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
              {r.sample && <span class="absolute start-3 top-3 rounded bg-alert px-2 py-1 text-xs font-semibold text-white">{sampleBadge(locale)}</span>}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center justify-between gap-2 text-xs text-slate-500">
                <span class="rounded bg-mist px-2 py-0.5 font-medium text-navy">{topicLabels[r.topic][locale]}</span>
                <time datetime={r.date}>{fmt.format(new Date(r.date))}</time>
              </div>
              <h3 class="mt-3 text-lg font-semibold text-navy group-hover:underline">{r.copy[locale].title}</h3>
              <p class="mt-2 flex-1 text-sm text-slate-600">{r.copy[locale].summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
