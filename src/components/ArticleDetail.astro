---
import { t, localePath, type Locale } from '../i18n/utils';
import type { Article } from '../content/news';
import { sampleBadge } from '../content/sample';
import Picture from './Picture.astro';

interface Props { locale: Locale; article: Article }
const { locale, article } = Astro.props;
const tr = t(locale);
const c = article.copy[locale];
const fmt = new Intl.DateTimeFormat(locale === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { dateStyle: 'medium' });
---
<article class="mx-auto max-w-3xl px-4 py-12 md:px-8">
  <nav aria-label={locale === 'fa' ? 'مسیر صفحه' : 'Breadcrumb'}>
    <a href={localePath(locale, '/news/')} class="text-sm font-medium text-teal hover:underline">← {tr('backToNews')}</a>
  </nav>
  {article.sample && <span class="mt-6 inline-block rounded bg-alert px-2 py-1 text-xs font-semibold text-white">{sampleBadge(locale)}</span>}
  <h1 class="mt-3">{c.title}</h1>
  <p class="mt-3 text-sm text-slate-500">
    <time datetime={article.date}>{tr('articleDate')}: {fmt.format(new Date(article.date))}</time>
  </p>
  <Picture src={article.image} alt={article.imageAlt[locale]} width={800} height={600} loading="eager" fetchpriority="high"
    sizes="(min-width: 768px) 768px, 100vw" class="mt-8 aspect-[4/3] w-full rounded-xl object-cover" />
  <div class="prose-custom mt-10 space-y-5 text-lg leading-relaxed text-slate-700">
    {c.body.map((p) => <p>{p}</p>)}
  </div>
</article>
