---
/**
 * نمایش یک فهرست مدیریتی (`ManagedField<string[]>`):
 * - تأییدشده: فهرست ساده.
 * - تأییدنشده: فهرست با برچسب و یادداشت «نیازمند تأیید مدیریت».
 * - خالی: متن «اعلام‌نشده» به‌همراه راهنمای تماس (بدون داده ساختگی).
 */
import PendingBadge from './PendingBadge.astro';
import { t, type Locale } from '../../i18n/utils';
import type { ManagedField } from '../../content/health';

interface Props {
  field: ManagedField<string[]>;
  locale?: Locale;
  ordered?: boolean;
  /** پیشوند «پیش‌نویس:» از متن هر مورد حذف می‌شود (برچسب کار را می‌کند). */
  stripDraftPrefix?: boolean;
}
const { field, locale = 'fa', ordered = false, stripDraftPrefix = true } = Astro.props;
const tr = t(locale);
const items = (field.value ?? []).map((i) => (stripDraftPrefix ? i.replace(/^پیش‌نویس:\s*/, '') : i));
const List = ordered ? 'ol' : 'ul';
---
{items.length === 0 ? (
  <p class="text-sm text-slate-600">
    {tr('healthNotAnnounced')}
  </p>
) : (
  <>
    {!field.approved && <PendingBadge class="mb-3" />}
    <List class={`space-y-2 text-slate-700 ${ordered ? 'list-decimal' : 'list-disc'} ps-5`}>
      {items.map((item) => <li>{item}</li>)}
    </List>
    {!field.approved && <p class="mt-3 text-xs text-slate-500">{tr('healthPendingNote')}</p>}
  </>
)}
