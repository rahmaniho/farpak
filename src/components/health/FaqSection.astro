---
/**
 * پرسش‌های متداول با <details>/<summary> — بدون هیچ JavaScript.
 * JSON-LD نوع FAQPage توسط صفحه والد اضافه می‌شود (faqPageSchema).
 */
import HealthIcon from './HealthIcon.astro';
import type { Faq } from '../../content/health';

interface Props {
  faqs: Faq[];
  headingId: string;
  title: string;
  class?: string;
}
const { faqs, headingId, title, class: className = '' } = Astro.props;
---
{faqs.length > 0 && (
  <section aria-labelledby={headingId} class={className}>
    <h2 id={headingId} class="text-2xl text-navy md:text-3xl">{title}</h2>
    <div class="mt-6 divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white">
      {faqs.map((faq, i) => (
        <details class="group bg-white px-5 py-4 transition open:bg-sky/40" data-faq-item={i}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-semibold text-navy [&::-webkit-details-marker]:hidden">
            <span>{faq.q}</span>
            <HealthIcon
              name="chevron"
              size={18}
              class="mt-1 shrink-0 text-teal transition-transform duration-200 group-open:rotate-90 rtl:group-open:-rotate-90"
            />
          </summary>
          <p class="mt-3 text-sm leading-7 text-slate-700">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
