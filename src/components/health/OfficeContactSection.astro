---
/**
 * بخش «تماس و مسیریابی» — پایین همه صفحات بخش خدمات سلامت.
 * نشانی، شماره‌های تماس (لینک استاندارد tel:)، ساعات کاری،
 * QR واقعی موقعیت و لینک نقشه.
 */
import HealthIcon from './HealthIcon.astro';
import OfficeActions from './OfficeActions.astro';
import { healthOffice } from '../../content/health';
import { t, type Locale } from '../../i18n/utils';
import { toFaDigits } from '../../lib/format';

interface Props { locale?: Locale; id?: string }
const { locale = 'fa', id = 'office-contact' } = Astro.props;
const tr = t(locale);
const coords = `${toFaDigits(healthOffice.geo.latitude.toFixed(7))}، ${toFaDigits(healthOffice.geo.longitude.toFixed(7))}`;
---
<section id={id} aria-labelledby={`${id}-h`} class="mt-20 border-t border-slate-200 bg-mist">
  <div class="mx-auto grid max-w-[1280px] gap-10 px-4 py-14 md:grid-cols-[1.5fr_1fr] md:px-8">
    <div>
      <p class="text-sm font-semibold text-health">{healthOffice.name}</p>
      <h2 id={`${id}-h`} class="mt-2 text-2xl text-navy md:text-3xl">{tr('healthContactSectionTitle')}</h2>
      <p class="mt-3 max-w-xl text-slate-600">{healthOffice.slogan}</p>

      <dl class="mt-8 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="flex items-center gap-2 text-sm font-semibold text-navy">
            <HealthIcon name="pin" size={16} class="text-teal" />
            {tr('healthAddressLabel')}
          </dt>
          <dd class="mt-2 text-sm leading-7 text-slate-700">{healthOffice.address}</dd>
        </div>

        <div>
          <dt class="flex items-center gap-2 text-sm font-semibold text-navy">
            <HealthIcon name="phone" size={16} class="text-teal" />
            {tr('healthPhoneLabel')}
          </dt>
          <dd class="mt-2 space-y-1 text-sm">
            {healthOffice.phones.map((p) => (
              <p class="flex items-center gap-2">
                <span class="text-slate-500">{p.label}:</span>
                <a href={`tel:${p.dial}`} dir="ltr" class="font-medium text-navy underline-offset-4 hover:text-teal hover:underline tabular-nums">
                  {p.display}
                </a>
              </p>
            ))}
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="flex items-center gap-2 text-sm font-semibold text-navy">
            <HealthIcon name="clock" size={16} class="text-teal" />
            {tr('healthHoursLabel')}
          </dt>
          <dd class="mt-2 text-sm text-slate-700">
            {healthOffice.hours ?? (
              <span class="inline-flex items-start gap-2">
                <HealthIcon name="info" size={16} class="mt-0.5 shrink-0 text-warning" />
                <span>{tr('healthHoursUnknown')}</span>
              </span>
            )}
          </dd>
        </div>
      </dl>

      <OfficeActions locale={locale} class="mt-8" showSecondPhone />
    </div>

    <aside class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h3 class="flex items-center gap-2 text-base font-semibold text-navy">
        <HealthIcon name="qr" size={18} class="text-teal" />
        {tr('healthMapLabel')}
      </h3>
      <img
        src={healthOffice.qrImage}
        alt={tr('healthQrHint')}
        width="180"
        height="180"
        loading="lazy"
        decoding="async"
        class="mx-auto mt-4 size-[180px] rounded-xl border border-slate-200 bg-white p-2"
      />
      <p class="mt-3 text-center text-xs text-slate-500">{tr('healthQrHint')}</p>

      <dl class="mt-5 space-y-2 border-t border-slate-200 pt-5 text-xs">
        <div class="flex justify-between gap-3">
          <dt class="text-slate-500">{tr('healthMapCoordinates')}</dt>
          <dd dir="ltr" class="font-medium text-navy tabular-nums">{coords}</dd>
        </div>
        <div>
          <dt class="sr-only">{tr('healthMapLabel')}</dt>
          <dd>
            <a
              href={healthOffice.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal"
            >
              <HealthIcon name="pin" size={16} />
              {tr('healthCtaDirections')}
            </a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
