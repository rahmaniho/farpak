---
/**
 * فهرست دوره‌های آموزشی بهداشت اصناف.
 * زمان، ظرفیت و هزینه هر دوره `ManagedField` هستند: تا تأیید مدیریت با
 * برچسب «نیازمند تأیید مدیریت» نمایش داده می‌شوند و اگر اعلام‌نشده باشند،
 * صراحتاً «اعلام‌نشده» نوشته می‌شود (بدون داده ساختگی).
 * دکمه ثبت‌نام با `?course=<id>#request` فرم همان صفحه را پیش‌پر می‌کند.
 */
import HealthIcon from './HealthIcon.astro';
import PendingBadge from './PendingBadge.astro';
import { courseStatusLabels, healthServicePath, type Course } from '../../content/health';
import { t, type Locale } from '../../i18n/utils';
import { faNumber } from '../../lib/format';

interface Props {
  courses: Course[];
  serviceSlug: string;
  locale?: Locale;
}
const { courses, serviceSlug, locale = 'fa' } = Astro.props;
const tr = t(locale);

const statusStyle: Record<Course['status'], string> = {
  open: 'bg-health-soft text-health',
  full: 'bg-warning/15 text-[#8a5200]',
  planned: 'bg-sky text-navy',
  closed: 'bg-slate-200 text-slate-600',
};

function capacityText(c: Course): string {
  const cap = c.capacity.value;
  if (!cap || cap.total == null) return tr('healthCapacityUnknown');
  const registered = cap.registered ?? 0;
  return `${faNumber(registered)} از ${faNumber(cap.total)} نفر`;
}
---
<div class="mt-6 grid gap-5 lg:grid-cols-3">
  {courses.map((course) => (
    <article class="health-card flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-sky text-navy">
          <HealthIcon name="training" size={22} />
        </span>
        <span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${statusStyle[course.status]}`}>
          {courseStatusLabels[course.status]}
        </span>
      </div>

      <h3 class="mt-4 text-lg font-semibold text-navy">{course.title}</h3>

      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
            <HealthIcon name="users" size={13} />
            {tr('healthCourseAudience')}
          </dt>
          <dd class="mt-1 leading-6 text-slate-700">{course.audience}</dd>
        </div>

        <div>
          <dt class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
            <HealthIcon name="calendar" size={13} />
            {tr('healthCourseSchedule')}
          </dt>
          <dd class="mt-1 flex flex-wrap items-center gap-2 text-slate-700">
            <span>{course.schedule.value ?? tr('healthNotAnnounced')}</span>
            {!course.schedule.approved && <PendingBadge />}
          </dd>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <dt class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
              <HealthIcon name="users" size={13} />
              {tr('healthCourseCapacity')}
            </dt>
            <dd class="mt-1 text-slate-700">{capacityText(course)}</dd>
            {course.capacity.value?.total != null && course.capacity.approved && (
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-100" aria-hidden="true">
                <div
                  class="h-full rounded-full bg-health"
                  style={`width:${Math.min(100, Math.round(((course.capacity.value?.registered ?? 0) / (course.capacity.value?.total ?? 1)) * 100))}%`}
                ></div>
              </div>
            )}
          </div>
          <div>
            <dt class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
              <HealthIcon name="wallet" size={13} />
              {tr('healthCourseFee')}
            </dt>
            <dd class="mt-1 text-slate-700">{course.fee.value ?? tr('healthNotAnnouncedShort')}</dd>
          </div>
        </div>
      </dl>

      <details class="mt-4 rounded-xl bg-mist p-3">
        <summary class="cursor-pointer list-none text-xs font-semibold text-navy [&::-webkit-details-marker]:hidden">
          {tr('healthCourseOutline')}
        </summary>
        <ul class="mt-2 list-disc space-y-1 ps-5 text-xs leading-6 text-slate-600">
          {(course.outline.value ?? []).map((item) => <li>{item.replace(/^پیش‌نویس:\s*/, '')}</li>)}
        </ul>
        {!course.outline.approved && <p class="mt-2 text-[11px] text-slate-500">{tr('healthPendingNote')}</p>}
      </details>

      <div class="mt-5 flex flex-wrap items-center gap-3 pt-1">
        <a
          href={`${healthServicePath(serviceSlug)}?course=${course.id}#request`}
          class="inline-flex items-center gap-1.5 rounded-md bg-health px-4 py-2 text-sm font-semibold text-white transition hover:brightness-95"
          data-course-enroll={course.id}
          data-course-title={course.title}
        >
          <HealthIcon name="clipboard" size={14} />
          {tr('healthEnroll')}
          <span class="sr-only"> — {course.title}</span>
        </a>
        <span class="text-xs text-slate-500">{courseStatusLabels[course.status]}</span>
      </div>
    </article>
  ))}
</div>
