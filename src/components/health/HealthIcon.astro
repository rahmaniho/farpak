---
/**
 * Inline SVG icon from the shared icon set (see ./icons.ts).
 * No JavaScript, no icon font, no third-party request.
 */
import { ICON_PATHS, ICON_VIEWBOX, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Accessible name. Omit for a decorative icon (aria-hidden is then set). */
  label?: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
}
const { name, label, class: className = 'size-6', size, strokeWidth = 1.75 } = Astro.props;
const paths = ICON_PATHS[name] ?? '';
---
<svg
  viewBox={ICON_VIEWBOX}
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths}
/>
