---
import { t, type Locale } from '../../i18n/utils';
import PageHero from '../../components/PageHero.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

const facts = [
  { label: 'factEnglishName', value: 'factEnglishNameValue', ltr: true },
  { label: 'factFounded', value: 'factFoundedValue', ltr: false },
  { label: 'factLegalType', value: 'factLegalTypeValue', ltr: false },
  { label: 'factStatus', value: 'factStatusValue', ltr: false },
  { label: 'factRegNo', value: 'factRegNoValue', ltr: false },
  { label: 'factNationalId', value: 'factNationalIdValue', ltr: false },
  { label: 'factCapital', value: 'factCapitalValue', ltr: false },
  { label: 'factGazette', value: 'factGazetteValue', ltr: false },
] as const;

const pillars = [
  { t: 'missionTitle', d: 'missionText', acc: 'var(--color-flux)' },
  { t: 'visionTitle', d: 'visionText', acc: 'var(--color-volt)' },
  { t: 'valuesTitle', d: 'valuesText', acc: 'var(--color-ember)' },
] as const;
---
<PageHero locale={locale} index="03" kicker={tr('navAbout')} title={tr('aboutTitle')} lead={tr('aboutIntro')} />

<section class="section" aria-labelledby="about-promise">
  <div class="shell-wide">
    <blockquote id="about-promise" class="glass glass-lit ticks panel relative max-w-4xl" style="--acc: var(--color-flux)" data-reveal="scale">
      <p class="mono-label mb-4 mono-label-bare">Farapak Promise</p>
      <p class="text-[clamp(1.3rem,2.6vw,2rem)] font-extrabold leading-snug">{tr('brandPromise')}</p>
    </blockquote>

    <ul class="mt-14 grid gap-5 md:grid-cols-3" data-stagger>
      {pillars.map((p, i) => (
        <li class="slab ticks panel h-full" style={`--acc: ${p.acc}`} data-reveal>
          <p class="mono mb-4 text-[0.625rem] uppercase tracking-[0.24em] text-ash" aria-hidden="true">P-0{i + 1}</p>
          <h2 class="text-[1.2rem] font-bold" style={`color: ${p.acc}`}>{tr(p.t)}</h2>
          <p class="mt-3 text-sm leading-relaxed text-fog">{tr(p.d)}</p>
        </li>
      ))}
    </ul>

    <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
      <section aria-labelledby="history-h" data-reveal="start">
        <p class="mono-label mb-4">{tr('historyTitle')}</p>
        <h2 id="history-h" class="sec-title">{tr('historyTitle')}</h2>
        <p class="mt-5 leading-relaxed text-fog">{tr('historyText')}</p>
      </section>

      <section aria-labelledby="facts-h" data-reveal="end">
        <p class="mono-label mb-4">{tr('specSheetLabel')}</p>
        <h2 id="facts-h" class="sec-title">{tr('aboutFactsTitle')}</h2>
        <dl class="spec mt-6">
          {facts.map((f) => (
            <div class="spec-row">
              <dt>{tr(f.label)}</dt>
              <dd dir={f.ltr ? 'ltr' : undefined} class={f.ltr ? 'text-end' : undefined}>{tr(f.value)}</dd>
            </div>
          ))}
          <div class="spec-row" style="grid-template-columns: 1fr">
            <dt class="mb-1">{tr('factFields')}</dt>
            <dd class="text-sm leading-relaxed text-fog">{tr('factFieldsValue')}</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</section>
