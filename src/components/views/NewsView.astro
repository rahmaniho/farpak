---
import { t, localePath, type Locale } from '../../i18n/utils';
import { articles } from '../../content/news';
import { sampleBadge } from '../../content/sample';
import Picture from '../Picture.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const sorted = [...articles].sort((a, b) => (a.date < b.date ? 1 : -1));
const fmt = new Intl.DateTimeFormat(locale === 'fa' ? 'fa-IR-u-ca-persian' : 'en-US', { dateStyle: 'medium' });
---
<section class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1>{tr('newsTitle')}</h1>
      <p class="mt-3 max-w-2xl text-slate-600">{tr('newsIntro')}</p>
    </div>
    <a href={localePath(locale, '/news/rss.xml')} class="text-sm font-medium text-teal hover:underline">RSS</a>
  </div>
  <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {sorted.map((a) => (
      <li class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="relative">
          <Picture src={a.image} alt={a.imageAlt[locale]} width={800} height={600} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          {a.sample && <span class="absolute start-3 top-3 rounded bg-alert px-2 py-1 text-xs font-semibold text-white">{sampleBadge(locale)}</span>}
        </div>
        <div class="flex flex-1 flex-col p-5">
          <time datetime={a.date} class="text-xs text-slate-500">{tr('articleDate')}: {fmt.format(new Date(a.date))}</time>
          <h2 class="mt-1 text-lg font-semibold text-navy">{a.copy[locale].title}</h2>
          <p class="mt-2 flex-1 text-sm text-slate-600">{a.copy[locale].summary}</p>
          <a href={localePath(locale, `/news/${a.slug}/`)} class="mt-4 font-semibold text-teal hover:underline">
            {tr('readArticle')}<span class="sr-only"> — {a.copy[locale].title}</span>
          </a>
        </div>
      </li>
    ))}
  </ul>
</section>
