---
import { t, localePath, type Locale } from '../../i18n/utils';
import { projects } from '../../content/projects';
import { sampleBadge } from '../../content/sample';
import Picture from '../../components/Picture.astro';
import PageHero from '../../components/PageHero.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const fmt = new Intl.NumberFormat(locale === 'fa' ? 'fa-IR' : 'en-US');
const accents = ['var(--color-flux)', 'var(--color-volt)', 'var(--color-ember)', 'var(--color-siren)'];
---
<PageHero locale={locale} index="06" kicker={tr('projectsKicker')} title={tr('projectsIndexTitle')} lead={tr('projectsIndexIntro')} />

<section class="section" aria-labelledby="projects-listing-h">
  <div class="shell-wide">
    <h2 id="projects-listing-h" class="sr-only">{tr('projectsIndexTitle')}</h2>
    <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-stagger>
      {projects.map((p, i) => (
        <li data-reveal>
          <a href={localePath(locale, `/projects/${p.slug}/`)} class="card ticks group h-full" style={`--acc: ${accents[i % accents.length]}`} data-spot>
            <div class="duotone aspect-[16/10]">
              <Picture src={p.image} alt={p.imageAlt[locale]} width={800} height={600} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" class="size-full" />
              {p.sample && <span class="badge-sample absolute start-3 top-3 z-10">{sampleBadge(locale)}</span>}
            </div>
            <div class="card-body">
              <p class="mono flex items-center justify-between text-[0.625rem] uppercase tracking-[0.2em] text-ash">
                <span>PRJ-{String(i + 1).padStart(2, '0')}</span>
                <span>{tr('projectYear')}: {fmt.format(p.year)}</span>
              </p>
              <h3 class="text-[1.1rem] font-bold leading-snug transition-colors duration-300 group-hover:text-flux">{p.copy[locale].title}</h3>
              <p class="flex-1 text-sm leading-relaxed text-fog">{p.copy[locale].summary}</p>
              <span class="link-arrow mt-1">
                {tr('viewProject')}<span class="sr-only"> — {p.copy[locale].title}</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="callout callout-warn mt-10">{tr('projectsIndexNote')}</p>
  </div>
</section>
