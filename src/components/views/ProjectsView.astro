---
import { t, localePath, type Locale } from '../../i18n/utils';
import { projects } from '../../content/projects';
import { sampleBadge } from '../../content/sample';
import Picture from '../Picture.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
---
<section class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
  <h1>{tr('projectsIndexTitle')}</h1>
  <p class="mt-3 max-w-2xl text-slate-600">{tr('projectsIndexIntro')}</p>
  <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((p) => (
      <li class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="relative">
          <Picture src={p.image} alt={p.imageAlt[locale]} width={800} height={600} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          {p.sample && <span class="absolute start-3 top-3 rounded bg-alert px-2 py-1 text-xs font-semibold text-white">{sampleBadge(locale)}</span>}
        </div>
        <div class="flex flex-1 flex-col p-5">
          <p class="text-xs text-slate-500">{tr('projectYear')}: {p.year}</p>
          <h2 class="mt-1 text-lg font-semibold text-navy">{p.copy[locale].title}</h2>
          <p class="mt-2 flex-1 text-sm text-slate-600">{p.copy[locale].summary}</p>
          <a href={localePath(locale, `/projects/${p.slug}/`)} class="mt-4 font-semibold text-teal hover:underline">
            {tr('viewProject')}<span class="sr-only"> — {p.copy[locale].title}</span>
          </a>
        </div>
      </li>
    ))}
  </ul>
  <p class="mt-8 text-sm text-slate-500">{tr('projectsIndexNote')}</p>
</section>
