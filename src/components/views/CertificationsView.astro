---
import { withBase } from '../../lib/base';
import { t, type Locale } from '../../i18n/utils';
import PageHero from '../../components/PageHero.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

const slots = [1, 2, 3, 4];
---
<PageHero
  locale={locale}
  index="08"
  kicker={tr('certKicker')}
  title={tr('certIndexTitle')}
  lead={tr('certIndexIntro')}
  image={withBase('/images/certifications-bg.jpg')}
  acc="var(--color-ember)"
/>

<section class="section" aria-labelledby="cert-slots-h">
  <div class="shell-wide">
    <h2 id="cert-slots-h" class="sr-only">{tr('certIndexTitle')}</h2>
    <ul class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4" data-stagger>
      {slots.map((n) => (
        <li
          class="ticks grid aspect-[4/3] flex-col items-center justify-center gap-3 rounded-[4px] border-2 border-dashed border-[rgba(255,255,255,0.16)] bg-[rgba(13,20,38,0.4)] p-6 text-center transition-colors duration-300 hover:border-[rgba(255,176,32,0.55)]"
          style="--acc: var(--color-ember)"
          data-reveal
        >
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="text-ash" aria-hidden="true">
            <circle cx="12" cy="9" r="5.5" /><path d="m9 13.5-1.6 7L12 18l4.6 2.5-1.6-7" />
          </svg>
          <span class="mono text-[0.625rem] uppercase tracking-[0.22em] text-ash">CERT-SLOT-0{n}</span>
          <span class="text-sm text-fog">{tr('certCardPlaceholder')}</span>
        </li>
      ))}
    </ul>
    <p class="callout callout-warn mt-10">{tr('certIndexNote')}</p>
  </div>
</section>
