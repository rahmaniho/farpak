---
import { withBase } from '../../lib/base';
import { t, type Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

const slots = [1, 2, 3, 4];
---
<section class="relative isolate overflow-hidden bg-navy text-white">
  <img src={withBase("/images/certifications-bg.jpg")} alt="" aria-hidden="true" width="1200" height="800" loading="lazy" decoding="async"
    class="absolute inset-0 -z-10 size-full object-cover opacity-30" />
  <div class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
    <h1 class="text-white">{tr('certIndexTitle')}</h1>
    <p class="mt-3 max-w-2xl text-slate-200">{tr('certIndexIntro')}</p>
  </div>
</section>
<section class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {slots.map(() => (
      <li class="flex aspect-[4/3] flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 p-6 text-center text-slate-500">
        <span class="text-sm">{tr('certCardPlaceholder')}</span>
      </li>
    ))}
  </ul>
  <p class="mt-8 text-sm text-slate-500">{tr('certIndexNote')}</p>
</section>
