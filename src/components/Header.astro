---
import { t, type Locale, localePath, switchLocalePath } from '../i18n/utils';
import { withBase } from '../lib/base';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;
const tr = t(locale);
const other: Locale = locale === 'fa' ? 'en' : 'fa';
const nav = [
  { href: localePath(locale, '/services/'), label: tr('navServices') },
  { href: localePath(locale, '/projects/'), label: tr('navProjects') },
  { href: localePath(locale, '/about/'), label: tr('navAbout') },
  { href: localePath(locale, '/news/'), label: tr('navNews') },
  { href: localePath(locale, '/contact/'), label: tr('navContact') },
];
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1280px] items-center justify-between gap-4 px-4 md:px-8">
    <a href={localePath(locale, '/')} class="flex items-center gap-2 font-semibold text-navy">
      <img src={withBase("/images/brand/logo-256.webp")} alt="" width="40" height="40" class="size-10 shrink-0" decoding="async" />
      <span>{tr('siteName')}</span>
    </a>

    <nav aria-label={locale === 'fa' ? 'ناوبری اصلی' : 'Main navigation'} class="hidden md:block">
      <ul class="flex items-center gap-6">
        {nav.map((item) => (
          <li><a href={item.href} class="text-sm font-medium text-ink hover:text-teal">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={localePath(locale, '/search/')} class="hidden rounded-md px-3 py-1.5 text-sm font-medium text-navy hover:bg-mist md:inline-block">{tr('navSearch')}</a>
      <a
        href={switchLocalePath(currentPath, other)}
        hreflang={other}
        lang={other}
        aria-label={tr('langSwitchLabel')}
        class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-navy hover:bg-mist"
      >{tr('langSwitch')}</a>
      <a href={localePath(locale, '/rfq/')} class="hidden rounded-md bg-alert px-4 py-2 text-sm font-semibold text-white hover:brightness-95 sm:inline-block">
        {tr('ctaRfq')}
      </a>
    </div>
  </div>

  <!-- Mobile navigation: native <details>, no JavaScript shipped -->
  <details class="border-t border-slate-200 md:hidden">
    <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-navy">{tr('menuOpen')}</summary>
    <ul class="flex flex-col gap-1 px-4 pb-4">
      {nav.map((item) => (
        <li><a href={item.href} class="block rounded-md px-2 py-2 text-ink hover:bg-mist">{item.label}</a></li>
      ))}
      <li><a href={localePath(locale, '/rfq/')} class="mt-2 block rounded-md bg-alert px-4 py-2 text-center font-semibold text-white">{tr('ctaRfq')}</a></li>
    </ul>
  </details>
</header>
