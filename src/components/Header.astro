---
import { t, type Locale, localePath, switchLocalePath } from '../i18n/utils';
import { withBase } from '../lib/base';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;
const tr = t(locale);
const other: Locale = locale === 'fa' ? 'en' : 'fa';
const nav = [
  { href: localePath(locale, '/services/'), label: tr('navServices') },
  { href: localePath(locale, '/projects/'), label: tr('navProjects') },
  { href: localePath(locale, '/about/'), label: tr('navAbout') },
  { href: localePath(locale, '/news/'), label: tr('navNews') },
  { href: localePath(locale, '/contact/'), label: tr('navContact') },
];
// Prefix match keeps child pages ("current") without exact equality.
const isCurrent = (href: string) => currentPath === href || (href !== localePath(locale, '/') && currentPath.startsWith(href));
const index = (i: number) => String(i + 1).padStart(2, '0');
---
<header data-header class="site-header">
  <div class="shell-wide">
    <div class="header-bar">
      <a href={localePath(locale, '/')} class="flex items-center gap-3" aria-label={tr('siteName')}>
        <span class="logo-mark">
          <img src={withBase('/images/brand/logo-256.webp')} alt="" width="44" height="44" decoding="async" />
        </span>
        <span class="logo-text">
          <span class="logo-name">{tr('siteName')}</span>
          <span class="logo-sub" lang="en" aria-hidden="true">Farapak · Est. 1403</span>
        </span>
      </a>

      <span class="grow" aria-hidden="true"></span>

      <nav aria-label={tr('mainNavLabel')} class="hidden lg:block">
        <ul class="flex items-center gap-6 xl:gap-8">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <span class="grow" aria-hidden="true"></span>

      <div class="hidden items-center gap-3 xl:flex" aria-hidden="true">
        <span class="dot-live" data-tone="volt"></span>
        <span class="mono text-[0.625rem] uppercase tracking-[0.22em] text-fog">{tr('headerStatusOk')}</span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={localePath(locale, '/search/')}
          class="grid size-11 place-items-center rounded-[4px] border border-line-2 bg-[rgba(13,20,38,0.38)] text-fog transition-colors duration-200 hover:border-[rgba(0,229,255,0.45)] hover:text-flux"
          aria-label={tr('navSearch')}
          aria-current={isCurrent(localePath(locale, '/search/')) ? 'page' : undefined}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.8-3.8" />
          </svg>
        </a>
        <a
          href={switchLocalePath(currentPath, other)}
          hreflang={other}
          lang={other}
          aria-label={tr('langSwitchLabel')}
          class="mono hidden size-11 place-items-center rounded-[4px] border border-line-2 bg-[rgba(13,20,38,0.38)] text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-chalk transition-colors duration-200 hover:border-[rgba(184,255,60,0.5)] hover:text-volt sm:grid"
        >
          {other}
        </a>
        <a href={localePath(locale, '/rfq/')} class="btn btn-primary btn-sm hidden sm:inline-flex" style="--acc: var(--color-volt)">
          {tr('ctaRfq')}
        </a>
        <details data-mobile-nav class="lg:hidden">
          <summary class="burger" aria-label={tr('menuOpen')}>
            <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
            <span class="sr-only">{tr('menuOpen')}</span>
          </summary>
          <div class="mobile-panel">
            <nav aria-label={tr('mainNavLabel')} class="shell py-6">
              <ul>
                {nav.map((item, i) => (
                  <li>
                    <a href={item.href} class="mobile-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      <span>{item.label}</span>
                      <span class="mono" aria-hidden="true">{index(i)}</span>
                    </a>
                  </li>
                ))}
                <li>
                  <a href={localePath(locale, '/search/')} class="mobile-link">
                    <span>{tr('navSearch')}</span>
                    <span class="mono" aria-hidden="true">06</span>
                  </a>
                </li>
              </ul>
              <div class="mt-6 flex flex-wrap items-center gap-3">
                <a href={localePath(locale, '/rfq/')} class="btn btn-primary" style="--acc: var(--color-volt)">{tr('ctaRfq')}</a>
                <a
                  href={switchLocalePath(currentPath, other)}
                  hreflang={other}
                  lang={other}
                  class="mono grid size-12 place-items-center rounded-[4px] border border-line-2 text-xs uppercase tracking-[0.16em] text-chalk"
                >
                  {other}
                </a>
              </div>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
