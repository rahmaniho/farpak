---
import { withBase } from '../lib/base';
import { t, type Locale, localePath } from '../i18n/utils';
import Picture from './Picture.astro';
import HealthIcon from './health/HealthIcon.astro';
import OfficeActions from './health/OfficeActions.astro';
import { projects } from '../content/projects';
import { healthOffice, sortedHealthServices } from '../content/health';
import { sampleBadge, sampleStats } from '../content/sample';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

const services = [
  { key: 'serviceEngineering', desc: 'serviceEngineeringDesc', slug: 'engineering' },
  { key: 'serviceConstruction', desc: 'serviceConstructionDesc', slug: 'construction' },
  { key: 'serviceFire', desc: 'serviceFireDesc', slug: 'fire-safety' },
  { key: 'serviceHse', desc: 'serviceHseDesc', slug: 'hse' },
  { key: 'serviceMaintenance', desc: 'serviceMaintenanceDesc', slug: 'maintenance' },
  { key: 'serviceUrban', desc: 'serviceUrbanDesc', slug: 'urban' },
] as const;

const why = [
  { t: 'why1Title', d: 'why1Desc' },
  { t: 'why2Title', d: 'why2Desc' },
  { t: 'why3Title', d: 'why3Desc' },
  { t: 'why4Title', d: 'why4Desc' },
] as const;

const stats = [
  { value: `${sampleStats.yearsOfExperience}+`, label: 'statYears' },
  { value: `${sampleStats.projectsDelivered}+`, label: 'statProjects' },
  { value: sampleStats.manHours, label: 'statManHours' },
] as const;

const featured = projects.slice(0, 3);
---
<!-- 1. Hero -->
<section class="relative isolate overflow-hidden bg-navy text-white">
  <Picture
    src={withBase("/images/hero-industrial-plant.jpg")}
    alt={tr('heroImageAlt')}
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    sizes="100vw"
    class="absolute inset-0 -z-10 size-full object-cover opacity-40"
  />
  <div class="mx-auto flex min-h-[70svh] max-w-[1280px] flex-col justify-center gap-6 px-4 py-24 md:px-8">
    <h1 class="max-w-3xl">{tr('heroTitle')}</h1>
    <p class="max-w-2xl text-lg text-slate-100">{tr('heroSubtitle')}</p>
    <div class="flex flex-wrap gap-3">
      <a href={localePath(locale, '/rfq/')} class="rounded-md bg-alert px-6 py-3 font-semibold text-white hover:brightness-95">{tr('heroCtaPrimary')}</a>
      <a href={localePath(locale, '/services/')} class="rounded-md border border-white px-6 py-3 font-semibold text-white hover:bg-white hover:text-navy">{tr('heroCtaSecondary')}</a>
    </div>
  </div>
</section>

<!-- 2. Trust bar -->
<section aria-labelledby="trust-title" class="border-b border-slate-200 bg-mist">
  <div class="mx-auto max-w-[1280px] px-4 py-10 md:px-8">
    <h2 id="trust-title" class="sr-only">{tr('trustTitle')}</h2>
    <dl class="grid grid-cols-1 gap-6 text-center sm:grid-cols-3">
      {stats.map((s) => (
        <div>
          <dt class="text-sm text-slate-600">{tr(s.label)}</dt>
          <dd class="text-3xl font-bold text-navy">{s.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-center text-xs text-slate-500">
      <span class="me-2 rounded bg-alert px-1.5 py-0.5 font-semibold text-white">{sampleBadge(locale)}</span>{tr('statsNote')}
    </p>
  </div>
</section>

<!-- 3. Services -->
<section aria-labelledby="services-title" class="mx-auto max-w-[1280px] px-4 py-20 md:px-8">
  <h2 id="services-title">{tr('servicesTitle')}</h2>
  <p class="mt-3 max-w-2xl text-slate-600">{tr('servicesIntro')}</p>
  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((s) => (
      <li class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <h3 class="text-navy">{tr(s.key)}</h3>
        <p class="mt-2 flex-1 text-slate-600">{tr(s.desc)}</p>
        <a href={localePath(locale, `/services/${s.slug}/`)} class="mt-4 inline-flex font-semibold text-teal hover:underline">
          {tr('learnMore')}<span class="sr-only"> — {tr(s.key)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<!-- 4. Why Farapak -->
<section aria-labelledby="why-title" class="bg-mist">
  <div class="mx-auto max-w-[1280px] px-4 py-20 md:px-8">
    <h2 id="why-title">{tr('whyTitle')}</h2>
    <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {why.map((w) => (
        <li class="border-t-4 border-teal pt-4">
          <h3 class="text-lg text-navy">{tr(w.t)}</h3>
          <p class="mt-2 text-slate-600">{tr(w.d)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 5. Featured projects -->
<section aria-labelledby="projects-title" class="mx-auto max-w-[1280px] px-4 py-20 md:px-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="projects-title">{tr('projectsTitle')}</h2>
    <a href={localePath(locale, '/projects/')} class="font-semibold text-teal hover:underline">{tr('navProjects')}</a>
  </div>
  <ul class="mt-10 grid gap-6 md:grid-cols-3">
    {featured.map((p) => (
      <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <a href={localePath(locale, `/projects/${p.slug}/`)} class="block">
          <div class="relative">
            <Picture src={p.image} alt={p.imageAlt[locale]} width={800} height={600} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            {p.sample && <span class="absolute start-3 top-3 rounded bg-alert px-2 py-1 text-xs font-semibold text-white">{sampleBadge(locale)}</span>}
          </div>
          <p class="p-5 font-semibold text-navy">{p.copy[locale].title}</p>
        </a>
      </li>
    ))}
  </ul>
</section>

<!-- 6. Certifications -->
<section aria-labelledby="cert-title" class="bg-navy text-white">
  <div class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
    <h2 id="cert-title" class="text-white">{tr('certTitle')}</h2>
    <p class="mt-3 text-slate-200">{tr('certPlaceholder')}</p>
  </div>
</section>

<!-- 6b. بخش خدمات سلامت ۴۷۷ (فقط فارسی) -->
{locale === 'fa' && (
  <section aria-labelledby="health-strip-title" class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-mist p-6 md:grid-cols-[1.5fr_1fr] md:p-10">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-health">
            <HealthIcon name="heart" size={14} />
            {tr('healthHeroEyebrow')}
          </p>
          <h2 id="health-strip-title" class="mt-4 text-2xl text-navy md:text-3xl">{tr('homeHealthTitle')}</h2>
          <p class="mt-3 max-w-xl leading-8 text-slate-600">{tr('homeHealthIntro')}</p>

          <ul class="mt-6 flex flex-wrap gap-2">
            {sortedHealthServices().map((s) => (
              <li>
                <a
                  href={localePath(locale, `/health/${s.slug}/`)}
                  class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-ink transition hover:border-teal hover:text-teal"
                >
                  <HealthIcon name={s.icon} size={15} />
                  {s.copy.shortTitle}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={localePath(locale, '/health/')}
              class="inline-flex items-center gap-2 rounded-md bg-navy px-5 py-3 font-semibold text-white transition hover:bg-teal"
            >
              {tr('homeHealthCta')}
              <HealthIcon name="chevron" size={16} class="rtl:rotate-180" />
            </a>
            <OfficeActions locale={locale} size="sm" />
          </div>
        </div>

        <aside class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="text-base font-semibold text-navy">{healthOffice.name}</h3>
          <p class="mt-3 flex items-start gap-2 text-sm leading-7 text-slate-600">
            <HealthIcon name="pin" size={16} class="mt-1 shrink-0 text-teal" />
            <span>{healthOffice.address}</span>
          </p>
          <ul class="mt-4 space-y-2 text-sm">
            {healthOffice.phones.map((ph) => (
              <li class="flex items-center justify-between gap-2">
                <span class="text-slate-500">{ph.label}</span>
                <a href={`tel:${ph.dial}`} dir="ltr" class="font-medium text-navy underline-offset-4 hover:text-teal hover:underline tabular-nums">{ph.display}</a>
              </li>
            ))}
          </ul>
          <div class="mt-5 flex items-center gap-4 border-t border-slate-200 pt-5">
            <img src={healthOffice.qrImage} alt={tr('healthQrHint')} width="84" height="84" loading="lazy" decoding="async" class="size-[84px] rounded-lg border border-slate-200 p-1" />
            <p class="text-xs leading-6 text-slate-500">{tr('healthQrHint')}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
)}

<!-- 7. Final CTA -->
<section aria-labelledby="cta-title" class="mx-auto max-w-[1280px] px-4 py-20 text-center md:px-8">
  <h2 id="cta-title">{tr('ctaFinalTitle')}</h2>
  <p class="mx-auto mt-3 max-w-xl text-slate-600">{tr('ctaFinalDesc')}</p>
  <a href={localePath(locale, '/rfq/')} class="mt-8 inline-block rounded-md bg-alert px-8 py-3 font-semibold text-white hover:brightness-95">{tr('ctaFinalButton')}</a>
</section>
