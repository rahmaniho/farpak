---
import { t, dictionaries, type Locale, localePath } from '../i18n/utils';
import type { Service } from '../content/services';
import RequestForm from './RequestForm';
import PageHero from './PageHero.astro';
import { services } from '../content/services';

interface Props { locale: Locale; service: Service }
const { locale, service } = Astro.props;
const tr = t(locale);
const copy = service.copy[locale];
const formServices = services.map((s) => ({ slug: s.slug, title: s.copy[locale].title }));
const idx = String(services.findIndex((s) => s.slug === service.slug) + 1).padStart(2, '0');
---
<PageHero locale={locale} index={idx} kicker={tr('servicesKicker')} title={copy.title} lead={copy.description} image={service.image} imageAlt={service.imageAlt[locale]}>
  <p class="mt-7 enter" style="--d: 320ms">
    <a href={localePath(locale, '/services/')} class="link-arrow">
      {tr('backToServices')}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
    </a>
  </p>
</PageHero>

<section class="section" aria-labelledby={`svc-${service.slug}-h`}>
  <div class="shell-wide">
    <h2 id={`svc-${service.slug}-h`} class="sr-only">{copy.title}</h2>
    <p class="mono-label mb-8" data-reveal>{tr('specSheetLabel')} · SVC-{idx}</p>

    <div class="grid gap-5 md:grid-cols-3" data-stagger>
      <section aria-labelledby="process-h" class="slab ticks panel" style="--acc: var(--color-flux)" data-reveal>
        <p class="mono mb-3 text-[0.625rem] uppercase tracking-[0.24em] text-flux" aria-hidden="true">A</p>
        <h3 id="process-h" class="text-[1.1rem] font-bold">{tr('processTitle')}</h3>
        <ol class="mt-4 space-y-3">
          {copy.process.map((step, i) => (
            <li class="flex gap-3 text-sm leading-relaxed text-fog">
              <span class="mono shrink-0 text-flux">{String(i + 1).padStart(2, '0')}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="out-h" class="slab ticks panel" style="--acc: var(--color-volt)" data-reveal>
        <p class="mono mb-3 text-[0.625rem] uppercase tracking-[0.24em] text-volt" aria-hidden="true">B</p>
        <h3 id="out-h" class="text-[1.1rem] font-bold">{tr('outputsTitle')}</h3>
        <ul class="mt-4 space-y-3">
          {copy.outputs.map((o) => (
            <li class="flex gap-3 text-sm leading-relaxed text-fog">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-volt" aria-hidden="true"></span>
              <span>{o}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="std-h" class="slab ticks panel" style="--acc: var(--color-ember)" data-reveal>
        <p class="mono mb-3 text-[0.625rem] uppercase tracking-[0.24em] text-ember" aria-hidden="true">C</p>
        <h3 id="std-h" class="text-[1.1rem] font-bold">{tr('standardsTitle')}</h3>
        <p class="mt-4 text-sm leading-relaxed text-fog">{copy.standards}</p>
      </section>
    </div>

    <section aria-labelledby="quote-h" class="glass panel ticks mt-16" style="--acc: var(--color-volt)" data-reveal="scale">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div>
          <p class="mono-label mb-4">{tr('ctaKicker')}</p>
          <h2 id="quote-h" class="sec-title">{tr('requestQuoteForService')}</h2>
          <p class="mt-4 text-sm leading-relaxed text-fog">{tr('rfqIntro')}</p>
          <ol class="mt-8 space-y-4">
            {(['rfqStep1', 'rfqStep2', 'rfqStep3', 'rfqStep4'] as const).map((k, i) => (
              <li class="flex items-start gap-3 text-sm text-fog">
                <span class="mono grid size-7 shrink-0 place-items-center rounded-full border border-[rgba(184,255,60,0.45)] text-[0.6875rem] font-bold text-volt">{i + 1}</span>
                <span class="pt-1">{tr(k)}</span>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <RequestForm client:visible mode="rfq" locale={locale} services={formServices} defaultService={service.slug} t={dictionaries[locale]} />
        </div>
      </div>
    </section>
  </div>
</section>
