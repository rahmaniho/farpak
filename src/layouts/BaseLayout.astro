---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale, switchLocalePath, dictionaries } from '../i18n/utils';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema } from '../lib/schema';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  currentPath: string;
  /** Used for the 404 page: no canonical/hreflang, search engines must skip it. */
  noindex?: boolean;
  /** Extra structured data (Service, BreadcrumbList, ...) added after Organization. */
  jsonLd?: Record<string, unknown>[];
}

const { locale, currentPath, title, description, jsonLd = [], noindex = false } = Astro.props;
const tr = t(locale);
const dir = locale === 'fa' ? 'rtl' : 'ltr';
const siteName = dictionaries[locale].siteName;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const pageDesc = description ?? dictionaries[locale].siteDescription;
// currentPath is already the full public path (e.g. /en/news/), so use it as-is.
const canonical = new URL(withBase(currentPath), Astro.site);
const altFa = new URL(switchLocalePath(currentPath, 'fa'), Astro.site);
const altEn = new URL(switchLocalePath(currentPath, 'en'), Astro.site);
// Watermarked 1731x909 image generated for social sharing.
const ogImage = new URL(withBase('/images/og-image.jpg'), Astro.site);
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070b18" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="fa" href={altFa} />
        <link rel="alternate" hreflang="en" href={altEn} />
        <link rel="alternate" hreflang="x-default" href={altFa} />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={tr('ogImageAlt')} />
    <meta property="og:locale" content={locale === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase("/favicon-256.png")} type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
    <JsonLd data={[organizationSchema(Astro.site!.origin, locale), ...jsonLd]} />
    <!-- Paint the night canvas before the stylesheet arrives: no white flash. -->
    <style is:inline>html,body{background:#070b18;color:#f2f5fa;margin:0}</style>
  </head>
  <body class="min-h-dvh antialiased">
    <a href="#main" class="skip-link">{tr('skipToContent')}</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <!-- Fixed ambient canvas: CAD grid, plant glow, grain, vignette. -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="canvas-grid"></div>
      <div class="canvas-orbs"></div>
      <div class="canvas-noise"></div>
      <div class="canvas-vignette"></div>
    </div>
    <div class="relative z-10 flex min-h-dvh flex-col">
      <Header locale={locale} currentPath={currentPath} />
      <main id="main" tabindex="-1" class="flex-1">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <script>import '../scripts/ui';</script>
  </body>
</html>
