---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale, localePath, switchLocalePath, dictionaries } from '../i18n/utils';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema } from '../lib/schema';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  currentPath: string;
  /** Used for the 404 page: no canonical/hreflang, search engines must skip it. */
  noindex?: boolean;
  /** Extra structured data (Service, BreadcrumbList, ...) added after Organization. */
  jsonLd?: Record<string, unknown>[];
  /** Brand name used in <title>/og:site_name (defaults to the site name). */
  brand?: string;
  /**
   * True when the page exists in one locale only (e.g. the Persian-only
   * health-services section). Then hreflang points to the same URL for
   * fa/x-default and the language switch is hidden instead of 404-ing.
   */
  singleLocale?: boolean;
}

const { locale, currentPath, title, description, jsonLd = [], noindex = false, brand, singleLocale = false } = Astro.props;
const tr = t(locale);
const dir = locale === 'fa' ? 'rtl' : 'ltr';
const siteName = dictionaries[locale].siteName;
const brandName = brand ?? siteName;
const pageTitle = title ? `${title} | ${brandName}` : brandName;
const pageDesc = description ?? dictionaries[locale].siteDescription;
// currentPath is already the full public path (e.g. /en/news/), so use it as-is.
const canonical = new URL(withBase(currentPath), Astro.site);
const altFa = new URL(switchLocalePath(currentPath, 'fa'), Astro.site);
const altEn = new URL(switchLocalePath(currentPath, 'en'), Astro.site);
// Watermarked 1731x909 image generated for social sharing.
const ogImage = new URL(withBase('/images/og-image.jpg'), Astro.site);
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : singleLocale ? (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="fa" href={canonical} />
        <link rel="alternate" hreflang="x-default" href={canonical} />
      </>
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="fa" href={altFa} />
        <link rel="alternate" hreflang="en" href={altEn} />
        <link rel="alternate" hreflang="x-default" href={altFa} />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={tr('ogImageAlt')} />
    <meta property="og:locale" content={locale === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:site_name" content={brandName} />
    <meta name="theme-color" content="#0a1f44" />
    <link rel="icon" href={withBase("/favicon-256.png")} type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
    <JsonLd data={[organizationSchema(Astro.site!.origin, locale), ...jsonLd]} />
  </head>
  <body class="min-h-dvh bg-white antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-navy focus:px-4 focus:py-2 focus:text-white">
      {tr('skipToContent')}
    </a>
    <Header locale={locale} currentPath={currentPath} langSwitchHref={singleLocale ? null : undefined} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
