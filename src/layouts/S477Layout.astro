---
import '../styles/global.css';
import Header from '../components/s477/Header.astro';
import Footer from '../components/s477/Footer.astro';
import ActionBar from '../components/s477/ActionBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { localBusiness477Schema } from '../lib/schema';
import { withBase } from '../lib/base';
import { BIZ } from '../content/s477';

interface Props {
  title?: string;
  description?: string;
  /** Full public path, e.g. /477/services/ */
  currentPath: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, currentPath, jsonLd = [] } = Astro.props;
const pageTitle = title ? `${title} | ${BIZ.nameFull}` : BIZ.nameFull;
const pageDesc = description ?? `${BIZ.slogan}؛ ${BIZ.address}. تماس: ${BIZ.phones[0].display}`;
const canonical = new URL(withBase(currentPath), Astro.site);
const ogImage = new URL(withBase('/images/s477-hero.jpg'), Astro.site);
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f8fc" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={BIZ.nameFull} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/favicon-256.png')} type="image/png" sizes="256x256" />
    <JsonLd data={[localBusiness477Schema(Astro.site!.origin, withBase('/images/s477-hero.jpg')), ...jsonLd]} />
    <style is:inline>html,body{background:#f4f8fc;color:#0c2440;margin:0}</style>
  </head>
  <body class="min-h-dvh antialiased">
    <div class="site-477 relative flex min-h-dvh flex-col">
      <a href="#main" class="skip-link">پرش به محتوا</a>
      <div class="scroll-progress" aria-hidden="true"></div>
      <div class="bg-canvas" aria-hidden="true">
        <div class="canvas-grid"></div>
        <div class="canvas-orbs"></div>
        <div class="canvas-noise"></div>
      </div>
      <div class="relative z-10 flex min-h-dvh flex-col">
        <Header currentPath={currentPath} />
        <main id="main" tabindex="-1" class="flex-1 pb-16 md:pb-0">
          <slot />
        </main>
        <Footer />
      </div>
      <ActionBar />
    </div>
    <script>import '../scripts/ui';</script>
  </body>
</html>
