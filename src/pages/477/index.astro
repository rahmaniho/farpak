---
import S477Layout from '../../layouts/S477Layout.astro';
import SectionHead from '../../components/SectionHead.astro';
import { withBase } from '../../lib/base';
import { BIZ, s477Services } from '../../content/s477';

const currentPath = '/477/';
---
<S477Layout currentPath={currentPath} description={`${BIZ.slogan}؛ کارت بهداشت، آموزش بهداشت اصناف، صلاحیت بهداشتی و ممیزی بهداشتی در قزوین.`}>
  <!-- ══ Hero ══ -->
  <section class="relative isolate overflow-hidden">
    <div class="shell-wide relative grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <div>
        <p class="mb-5 flex flex-wrap items-center gap-3 enter" style="--d: 60ms">
          <span class="chip chip-accent" style="--acc: var(--color-flux)">
            <span class="dot-live" data-tone="flux" aria-hidden="true"></span>
            قزوین · خیابان طالقانی
          </span>
          <span class="mono text-[0.625rem] uppercase tracking-[0.22em] text-ash" dir="ltr" aria-hidden="true">36.2678°N 50.0135°E</span>
        </p>
        <h1 class="max-w-2xl enter" style="--d: 140ms; font-size: clamp(2rem, 5vw, 3.6rem)">
          دفتر خدمات سلامت <span class="text-[color:var(--color-flux)]">۴۷۷</span> قزوین
        </h1>
        <p class="mt-5 max-w-xl text-[1.05rem] font-semibold leading-relaxed text-[color:var(--color-volt)] enter md:text-[1.25rem]" style="--d: 240ms">
          {BIZ.slogan}
        </p>
        <p class="mt-4 max-w-xl leading-relaxed text-fog enter" style="--d: 320ms">
          ثبت و صدور کارت بهداشت، آموزش بهداشت اصناف، صلاحیت بهداشتی، طرح خودکنترلی و خوداظهاری بهداشت و قراردادهای ممیزی بهداشتی — همه از یک دفتر، با پیگیری تا نتیجه.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 enter" style="--d: 420ms">
          <a href={`tel:${BIZ.phones[0].tel}`} class="btn btn-primary btn-lg" style="--acc: var(--color-flux)">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
            تماس با دفتر
          </a>
          <a href={BIZ.maps} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg" style="--acc: var(--color-volt)">مشاهده موقعیت دفتر</a>
        </div>
        <p class="mt-8 flex items-start gap-2 text-sm text-fog enter" style="--d: 520ms">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-[color:var(--color-volt)]" aria-hidden="true"><path d="M12 3 5 6v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6l-7-3Z" /><path d="m9 12 2.2 2.2L15.5 10" /></svg>
          <span>{BIZ.trustPath}</span>
        </p>
      </div>

      <div class="glass panel ticks relative enter" style="--d: 300ms; --acc: var(--color-flux)" data-reveal="scale">
        <p class="mono-label mb-5 mono-label-bare">دسترسی سریع</p>
        <ul class="grid gap-3">
          <li>
            <a href={withBase('/477/services/')} class="group flex items-center justify-between gap-4 rounded-[12px] border border-line bg-white/70 px-4 py-3.5 transition-all duration-300 hover:-translate-y-0.5 hover:border-[rgba(11,107,203,0.45)]">
              <span class="font-bold">همه خدمات دفتر</span>
              <span class="mono text-[0.6875rem] text-ash transition-colors group-hover:text-[color:var(--color-flux)]" aria-hidden="true">01 →</span>
            </a>
          </li>
          {s477Services.slice(0, 4).map((s, i) => (
            <li>
              <a href={withBase(`/477/services/${s.slug}/`)} class="group flex items-center justify-between gap-4 rounded-[12px] border border-line bg-white/70 px-4 py-3.5 transition-all duration-300 hover:-translate-y-0.5" style={`border-color: var(--color-line)`}>
                <span class="flex items-center gap-3">
                  <span class="svc-icon" style={`--acc: ${s.accent}; width: 38px; height: 38px; border-radius: 10px`}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
                  </span>
                  <span class="font-bold">{s.title}</span>
                </span>
                <span class="mono text-[0.6875rem] text-ash" aria-hidden="true">0{i + 2} →</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-5 border-t border-line pt-4 text-xs leading-relaxed text-fog">
          این وب‌سایت فروش اینترنتی ندارد؛ هدف، رساندن شما به دفتر است: تلفن، مسیریابی یا ثبت درخواست.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ Services ══ -->
  <section class="section border-t border-line bg-white/60" aria-labelledby="s477-services-h">
    <div class="shell-wide">
      <SectionHead
        locale="fa"
        index="01"
        kicker="خدمات دفتر"
        title="خدمات ما"
        intro="هر خدمت صفحه اختصاصی، مراحل روشن، مدارک مورد نیاز و فرم درخواست اولیه دارد."
        actionHref={withBase('/477/services/')}
        actionLabel="مشاهده همه خدمات"
        id="s477-services-h"
      />
      <ul class="mt-12 grid gap-5 md:grid-cols-2" data-stagger>
        {s477Services.map((s) => (
          <li data-reveal>
            <article class="card ticks h-full" style={`--acc: ${s.accent}`} data-spot>
              <div class="card-body">
                <div class="flex items-start justify-between gap-4">
                  <span class="svc-icon" style={`--acc: ${s.accent}`}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
                  </span>
                  <span class="chip chip-accent" style={`--acc: ${s.accent}`}>خدمت فعال</span>
                </div>
                <h3 class="mt-2 text-[1.2rem] font-extrabold">{s.title}</h3>
                <p class="flex-1 text-sm leading-relaxed text-fog">{s.short}</p>
                <div class="mt-2 flex flex-wrap items-center gap-4">
                  <a href={withBase(`/477/services/${s.slug}/`)} class="link-arrow" style={`--acc: ${s.accent}`}>
                    جزئیات بیشتر
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                  </a>
                  <a href={`tel:${BIZ.phones[0].tel}`} class="mono text-[0.6875rem] uppercase tracking-[0.14em] text-fog underline-offset-4 hover:underline">تماس مستقیم</a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ Why 477 ══ -->
  <section class="section" aria-labelledby="why477-h">
    <div class="shell-wide">
      <SectionHead locale="fa" index="02" kicker="مسیر اعتماد" title="چرا دفتر ۴۷۷؟" id="why477-h" acc="var(--color-volt)" />
      <ul class="mt-10 grid gap-5 md:grid-cols-3" data-stagger>
        {[
          { t: 'معرفی‌شده توسط شبکه بهداشت', d: BIZ.trustPath + '؛ همان مسیری که بیشتر مراجعان ما از آن رسیده‌اند.', acc: 'var(--color-volt)' },
          { t: 'تمرکز بر ارتباط، نه فروش', d: 'سایت برای این است که ما را پیدا کنید و تماس بگیرید؛ بدون سبد خرید و بدون پرداخت آنلاین.', acc: 'var(--color-flux)' },
          { t: 'فرایند شفاف، مرحله‌به‌مرحله', d: 'برای هر خدمت، مراحل و مدارک را روشن نوشته‌ایم و هر آنچه هنوز تأیید نشده را صریح اعلام می‌کنیم.', acc: 'var(--color-ember)' },
        ].map((w) => (
          <li class="slab ticks panel" style={`--acc: ${w.acc}`} data-reveal>
            <span class="mb-4 block h-1 w-10" style={`background: ${w.acc}`} aria-hidden="true"></span>
            <h3 class="text-[1.05rem] font-extrabold">{w.t}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-fog">{w.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ Contact / NAP ══ -->
  <section id="contact" class="section border-t border-line bg-white/60" aria-labelledby="contact477-h">
    <div class="shell-wide">
      <SectionHead locale="fa" index="03" kicker="تماس و مسیریابی" title="دفتر را پیدا کنید" id="contact477-h" acc="var(--color-flux)" />
      <div class="mt-10 grid gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div class="slab ticks panel nap" style="--acc: var(--color-flux)" data-reveal="start">
          <dl class="spec">
            <div class="spec-row" style="grid-template-columns: 1fr">
              <dt class="mb-1">نشانی دفتر</dt>
              <dd><address>{BIZ.address}</address></dd>
            </div>
            {BIZ.phones.map((p, i) => (
              <div class="spec-row">
                <dt>تلفن {i === 0 ? 'همراه' : 'دفتر'}</dt>
                <dd><a class="link-arrow" style="--acc: var(--color-flux)" href={`tel:${p.tel}`} dir="ltr">{p.display}</a></dd>
              </div>
            ))}
            <div class="spec-row">
              <dt>اینستاگرام</dt>
              <dd><a class="link-arrow" style="--acc: var(--color-ember)" href={BIZ.instagram} target="_blank" rel="noopener noreferrer" dir="ltr">{BIZ.instagramHandle}</a></dd>
            </div>
          </dl>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={BIZ.maps} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="--acc: var(--color-volt)">مسیریابی به دفتر</a>
            <button type="button" class="btn btn-ghost btn-sm" data-copy={String(new URL(withBase(currentPath), Astro.site))} data-copied-label="کپی شد">
              کپی نشانی صفحه
            </button>
          </div>
        </div>
        <div class="glass panel ticks" style="--acc: var(--color-volt)" data-reveal="end">
          <p class="mono-label mb-4 mono-label-bare">ساعات پاسخ‌گویی</p>
          <p class="text-sm leading-relaxed text-fog">
            ساعات کاری رسمی دفتر پس از تأیید مدیریت روی سایت و پروفایل گوگل منتشر می‌شود.
            تا آن زمان، سریع‌ترین راه تماس، شماره همراه دفتر است؛ اگر در جلسه یا بازدید باشیم، با شما تماس می‌گیریم.
          </p>
          <p class="mt-5 flex items-center gap-2 text-sm font-bold">
            <span class="dot-live" aria-hidden="true"></span>
            پاسخ‌گویی درخواست‌های ثبت‌شده: روزهای کاری
          </p>
        </div>
      </div>
    </div>
  </section>
</S477Layout>
