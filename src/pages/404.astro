---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, localePath } from '../i18n/utils';

const tr = t('fa');
const links = [
  { href: localePath('fa', '/services/'), label: tr('notFoundServices') },
  { href: localePath('fa', '/news/'), label: tr('notFoundNews') },
  { href: localePath('fa', '/contact/'), label: tr('notFoundContact') },
  { href: localePath('fa', '/search/'), label: tr('notFoundSearch') },
];
---
<BaseLayout locale="fa" currentPath="/" title={tr('notFoundTitle')} noindex>
  <section class="shell-wide relative py-24 md:py-32">
    <p class="wordmark-outline enter" style="--d: 60ms" aria-hidden="true">404</p>
    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <div>
        <p class="mono-label mb-5 enter" style="--d: 160ms">{tr('notFoundCode')}</p>
        <h1 class="max-w-2xl enter" style="--d: 240ms">{tr('notFoundHeading')}</h1>
        <p class="mt-5 max-w-xl text-[1.05rem] leading-relaxed text-fog enter" style="--d: 340ms">{tr('notFoundText')}</p>
        <div class="mt-9 flex flex-wrap gap-4 enter" style="--d: 440ms">
          <a href={localePath('fa', '/')} class="btn btn-primary" style="--acc: var(--color-volt)">{tr('notFoundHome')}</a>
          <a href={localePath('en', '/')} lang="en" hreflang="en" class="btn btn-ghost">{tr('notFoundEnglish')}</a>
        </div>
      </div>
      <nav aria-label={tr('notFoundHeading')} class="enter" style="--d: 520ms">
        <ul class="divide-y divide-[rgba(255,255,255,0.08)] border-y border-line">
          {links.map((l, i) => (
            <li>
              <a href={l.href} class="group flex min-h-14 items-center justify-between gap-4 py-3 transition-all duration-300 hover:ps-3">
                <span class="font-semibold">{l.label}</span>
                <span class="mono text-[0.6875rem] tracking-[0.2em] text-ash transition-colors group-hover:text-flux" aria-hidden="true">
                  0{i + 1} →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>
