---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { services } from '../../content/services';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const copy = service.copy.fa;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = Astro.site!.origin;
const homeUrl = new URL('/', Astro.site).href;
const servicesUrl = new URL('/services/', Astro.site).href;
const jsonLd = [
  serviceSchema(siteUrl, pageUrl, 'fa', copy.title, copy.summary),
  breadcrumbSchema([
    { name: 'خانه', url: homeUrl },
    { name: 'خدمات', url: servicesUrl },
    { name: copy.title, url: pageUrl },
  ]),
];
---
<BaseLayout locale="fa" currentPath={`/services/${service.slug}/`} title={copy.title} description={copy.summary} jsonLd={jsonLd}>
  <ServiceDetail locale="fa" service={service} />
</BaseLayout>
