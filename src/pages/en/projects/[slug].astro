---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { projects } from '../../../content/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout locale="en" currentPath={`/en/projects/${project.slug}/`} title={project.copy.en.title} description={project.copy.en.summary}>
  <ProjectDetail locale="en" project={project} />
</BaseLayout>
