---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RequestForm from '../../../components/RequestForm';
import PageHero from '../../../components/PageHero.astro';
import { t, dictionaries } from '../../../i18n/utils';
import { services } from '../../../content/services';

const tr = t('en');
const formServices = services.map((s) => ({ slug: s.slug, title: s.copy.en.title }));
---
<BaseLayout locale="en" currentPath="/en/rfq/" title={tr('rfqTitle')}>
  <PageHero locale="en" index="10" kicker={tr('ctaRfq')} title={tr('rfqTitle')} lead={tr('rfqIntro')} acc="var(--color-volt)" />

  <section class="section" aria-labelledby="rfq-form-h">
    <div class="shell-wide">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <aside class="slab ticks panel h-fit lg:sticky lg:top-28" style="--acc: var(--color-volt)">
          <p class="mono-label mb-5">{tr('rfqPanelTitle')}</p>
          <ol class="space-y-5">
            {(['rfqStep1', 'rfqStep2', 'rfqStep3', 'rfqStep4'] as const).map((k, i) => (
              <li class="relative flex items-start gap-4 ps-1">
                <span class="mono grid size-9 shrink-0 place-items-center rounded-full border border-[rgba(184,255,60,0.45)] bg-[rgba(184,255,60,0.08)] text-[0.75rem] font-bold text-volt">{i + 1}</span>
                <span class="pt-1.5 text-sm leading-relaxed text-fog">{tr(k)}</span>
                {i < 3 && <span class="absolute start-[1.15rem] top-10 h-[calc(100%-1rem)] w-px bg-[rgba(255,255,255,0.12)]" aria-hidden="true"></span>}
              </li>
            ))}
          </ol>
          <p class="mt-8 border-t border-line pt-5 text-xs leading-relaxed text-ash">{tr('privacy')}</p>
        </aside>

        <div class="glass panel ticks" style="--acc: var(--color-volt)">
          <h2 id="rfq-form-h" class="sec-title mb-8">{tr('rfqTitle')}</h2>
          <RequestForm client:visible mode="rfq" locale="en" services={formServices} t={dictionaries.en} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
