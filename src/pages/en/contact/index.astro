---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RequestForm from '../../../components/RequestForm';
import PageHero from '../../../components/PageHero.astro';
import { t, dictionaries, localePath } from '../../../i18n/utils';
import { services } from '../../../content/services';
import { sampleContact } from '../../../content/sample';

const tr = t('en');
const formServices = services.map((s) => ({ slug: s.slug, title: s.copy.en.title }));

const channels: { icon: string; label: string; value: string; href?: string; ltr?: boolean }[] = [
  { icon: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/>', label: tr('contactPhoneLabel'), value: sampleContact.phone, href: `tel:${sampleContact.phone.replace(/\s/g, '')}`, ltr: true },
  { icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>', label: tr('contactEmailLabel'), value: sampleContact.email, href: `mailto:${sampleContact.email}`, ltr: true },
  { icon: '<path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>', label: tr('contactAddressLabel'), value: sampleContact.address.en },
  { icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>', label: tr('contactHoursLabel'), value: tr('contactHoursValue') },
];
---
<BaseLayout locale="en" currentPath="/en/contact/" title={tr('contactTitle')}>
  <PageHero locale="en" index="09" kicker={tr('navContact')} title={tr('contactTitle')} lead={tr('contactIntro')} acc="var(--color-volt)" />

  <section class="section" aria-labelledby="contact-form-h">
    <div class="shell-wide">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
        <div class="space-y-5">
          <ul class="space-y-3">
            {channels.map((c) => (
              <li class="slab ticks panel flex items-start gap-4" style="--acc: var(--color-flux)">
                <span class="grid size-11 shrink-0 place-items-center rounded-[4px] border border-[rgba(0,229,255,0.35)] bg-[rgba(0,229,255,0.08)] text-flux">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
                </span>
                <span class="min-w-0">
                  <span class="mono block text-[0.625rem] uppercase tracking-[0.2em] text-ash">{c.label}</span>
                  {c.href ? (
                    <a href={c.href} dir={c.ltr ? 'ltr' : undefined} class="link-arrow mt-1 break-all">{c.value}</a>
                  ) : (
                    <span class="mt-1 block text-sm leading-relaxed text-chalk/90">{c.value}</span>
                  )}
                </span>
              </li>
            ))}
          </ul>
          <a href={localePath('en', '/rfq/')} class="btn btn-primary w-full" style="--acc: var(--color-volt)">{tr('ctaRfq')}</a>
        </div>

        <div class="glass panel ticks" style="--acc: var(--color-volt)">
          <h2 id="contact-form-h" class="sec-title mb-8">{tr('contactTitle')}</h2>
          <RequestForm client:visible mode="contact" locale="en" services={formServices} t={dictionaries.en} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
