---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NewsView from '../../../../components/views/NewsView.astro';
import { allListingStates } from '../../../../lib/newsListing';

export function getStaticPaths() {
  return allListingStates()
    .filter((s) => !s.topic && s.page > 1)
    .map((state) => ({ params: { page: String(state.page) }, props: { state } }));
}
const { state } = Astro.props;
---
<BaseLayout locale="en" currentPath={`/en/news/page/${state.page}/`} title={`News & technical articles - page ${state.page}`}>
  <NewsView locale="en" state={state} />
</BaseLayout>
