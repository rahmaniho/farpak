---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RequestForm from '../../components/RequestForm';
import { t, dictionaries } from '../../i18n/utils';
import { services } from '../../content/services';

const tr = t('fa');
const formServices = services.map((s) => ({ slug: s.slug, title: s.copy.fa.title }));
---
<BaseLayout locale="fa" currentPath="/contact/" title={tr('contactTitle')}>
  <section class="mx-auto max-w-[1280px] px-4 py-16 md:px-8">
    <h1>{tr('contactTitle')}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{tr('contactIntro')}</p>
    <div class="mt-10 max-w-3xl">
      <RequestForm client:visible mode="contact" locale="fa" services={formServices} t={dictionaries.fa} />
    </div>
  </section>
</BaseLayout>
